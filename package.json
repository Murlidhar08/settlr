{
  "name": "settlr",
  "version": "1.0.5",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "node server.js",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "production-deploy": "npm run postinstall && prisma migrate deploy && npm run build",
    "production-build": "npm run postinstall && npm run build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./lib/auth/auth.ts --yes",
    "typecheck": "tsc --noEmit",
    "sync-template": "git fetch upstream && git merge upstream/main"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/passkey": "^1.6.23",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/pg": "^8.20.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.3",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "react-hook-form": "^7.80.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "jimp": "^1.6.1",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}